shopstream:
  target: dev
  outputs:
    dev:
      type: postgres          # change to bigquery / snowflake / duckdb etc.
      host: localhost
      user: "{{ env_var('DBT_USER') }}"
      password: "{{ env_var('DBT_PASSWORD') }}"
      port: 5432
      dbname: shopstream
      schema: dbt_dev         # each developer gets their own schema
      threads: 4

    ci:
      type: postgres
      host: "{{ env_var('DBT_HOST') }}"
      user: "{{ env_var('DBT_USER') }}"
      password: "{{ env_var('DBT_PASSWORD') }}"
      port: 5432
      dbname: shopstream
      schema: dbt_ci
      threads: 8

    prod:
      type: postgres
      host: "{{ env_var('DBT_PROD_HOST') }}"
      user: "{{ env_var('DBT_PROD_USER') }}"
      password: "{{ env_var('DBT_PROD_PASSWORD') }}"
      port: 5432
      dbname: shopstream
      schema: analytics
      threads: 16
