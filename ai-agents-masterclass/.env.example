# LLM API Keys (get from provider dashboards)
OPENAI_API_KEY=sk-...your-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Optional: LangSmith for tracing/debugging
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-agents-masterclass

# Database (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agents_user
POSTGRES_PASSWORD=agents_password
POSTGRES_DB=agents_db
DATABASE_URL=postgresql://agents_user:agents_password@localhost:5432/agents_db

# Redis
REDIS_URL=redis://localhost:6379

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# App settings
APP_ENV=development
LOG_LEVEL=INFO
MAX_ITERATIONS=10
DEFAULT_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.3
COST_LIMIT_PER_REQUEST=0.50
